---
export interface Crumb { label: string; href: string }
export interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>
        {i === items.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { padding-top: var(--s5); }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s2); margin: 0; padding: 0; font-size: var(--fs-small); color: var(--muted); }
  li + li::before { content: '/'; margin-right: var(--s2); color: var(--muted); }
  a { color: var(--muted); }
  span { color: var(--ink); }
</style>
