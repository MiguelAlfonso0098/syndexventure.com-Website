---
export interface Props { title: string; lede?: string; eyebrow?: string }
const { title, lede, eyebrow } = Astro.props;
---
<header class="page-header">
  {eyebrow && <p class="label">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
<style>
  .page-header { padding-block: var(--s6) var(--s6); border-bottom: 1px solid var(--line); margin-bottom: var(--s6); }
  .page-header .label { margin-bottom: var(--s3); }
</style>
