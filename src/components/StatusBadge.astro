---
export interface Props { status: 'Official' | 'Active' | 'Under review' | 'Retired' | 'Not recognized' }
const { status } = Astro.props;
const tone = status === 'Official' || status === 'Active' ? 'ok' : status === 'Not recognized' ? 'warn' : 'muted';
---
<span class={`badge ${tone}`}><span class="dot" aria-hidden="true"></span>{status}</span>
<style>
  .badge { display: inline-flex; align-items: center; gap: var(--s2); padding: 2px var(--s3); border-radius: 999px; border: 1px solid var(--line); font: 500 var(--fs-data)/var(--lh-data) var(--font-mono); white-space: nowrap; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .ok { color: var(--success-text); } .ok .dot { background: var(--success); }
  .warn { color: var(--warn); border-color: var(--warn); } .warn .dot { background: var(--warn); }
  .muted { color: var(--muted); }
</style>
