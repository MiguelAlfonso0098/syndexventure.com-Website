---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
---
<BaseLayout title="Notice received" noindex crumbs={[{ label: 'Compliance', href: '/compliance/' }, { label: 'Notice received', href: '/compliance/intellectual-property/thanks/' }]}>
  <PageHeader title="Notice received" lede="We review the listing and remove it if it infringes. A receipt is on its way to your email.">
    <p>Reference ID: <code data-ref>sent in your receipt</code></p>
  </PageHeader>
  <p><a href="/compliance/intellectual-property/">Back to IP &amp; Takedown</a></p>
</BaseLayout>
<script>
  const ref = new URLSearchParams(location.search).get('ref');
  if (ref && /^[A-Z]{2}-\d{4}-[A-Z0-9]{6}$/.test(ref)) document.querySelector('[data-ref]')!.textContent = ref;
</script>
