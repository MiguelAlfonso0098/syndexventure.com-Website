---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { DILIGENCE_SLA } from '@/config/site';
---
<BaseLayout title="Request received" noindex crumbs={[{ label: 'Due Diligence', href: '/diligence/' }, { label: 'Request received', href: '/diligence/request/thanks/' }]}>
  <PageHeader title="Request received" lede={`We will review your request and reply within ${DILIGENCE_SLA}. A receipt is on its way to your email.`}>
    <p>Reference ID: <code data-ref>sent in your receipt</code></p>
  </PageHeader>
  <p><a href="/diligence/">Back to the Due Diligence Room</a></p>
</BaseLayout>
<script>
  const ref = new URLSearchParams(location.search).get('ref');
  if (ref && /^[A-Z]{2}-\d{4}-[A-Z0-9]{6}$/.test(ref)) document.querySelector('[data-ref]')!.textContent = ref;
</script>
